{
  "name": "onmind-pre",
  "version": "0.2.0",
  "description": "Predefined Routine Environment (PRE) - YAML + Bash runner on Bun",
  "type": "module",
  "main": "main.ts",
  "scripts": {
    "start": "bun main.ts --config examples/pre_deno.yml",
    "compile:mac": "bun build --compile ./main.ts --outfile onmind-pre-mac",
    "compile:linux": "bun build --compile --target=bun-linux-x64 ./main.ts --outfile onmind-pre-linux",
    "compile:win": "bun build --compile --target=bun-windows-x64 ./main.ts --outfile onmind-pre-win.exe"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9"
  }
}
